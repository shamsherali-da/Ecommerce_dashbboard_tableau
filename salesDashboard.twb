      <aliases enabled='yes' />
      <column caption='ytd sales' datatype='real' name='[Calculation_0215529998901248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date] )={ MAX(YEAR([Order Date]))} then [Sales] END' />
      </column>
      <column caption='% difference' datatype='real' name='[Calculation_0215530019508226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0215529998901248])-SUM([ytd sales (copy)_0215530018205697]))/SUM([ytd sales (copy)_0215530018205697])' />
      </column>
      <column caption='margin sales' datatype='string' name='[Calculation_0656159455891456]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([Calculation_0215529998901248])-SUM([ytd sales (copy)_0215530018205697]))&lt;0 THEN &apos;less than PY&apos;&#13;&#10;ELSEIF (SUM([Calculation_0215529998901248])-SUM([ytd sales (copy)_0215530018205697]))&gt;0 THEN &apos;greater than PY&apos;&#13;&#10;ELSEIF ISNULL(SUM([ytd sales (copy)_0215530018205697])) THEN &apos;no sales in PY&apos;&#13;&#10;END' />
      </column>
      <column caption='positve % diff' datatype='string' name='[Calculation_0656159458308097]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0215530019508226]&gt;0 THEN &apos;▲&apos; END' />
      </column>
      <column caption='Negative % diff' datatype='string' name='[Calculation_0656159458471938]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0215530019508226]&lt; 0 then &apos;▼&apos; END' />
      </column>
      <column caption='no sales' datatype='string' name='[Calculation_0656159460368387]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0656159455891456]= &apos;no sales in PY&apos; then &apos; no sales in PY&apos; END' />
      </column>
      <column caption='ytd sales lod' datatype='real' name='[Calculation_0930212439986176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))} then [Sales] END) }' />
      </column>
      <column caption='YOY sales %' datatype='real' name='[Calculation_0930212461027330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0930212439986176]-[ytd sales lod (copy)_0930212460060673])/[ytd sales lod (copy)_0930212460060673]' />
      </column>
      <column caption='yoy sales margin' datatype='string' name='[Calculation_0930212465696771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0930212461027330]&gt; 0 then &apos;▲&apos; ELSE &apos;▼&apos; END' />
